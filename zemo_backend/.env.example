# Zemo Backend Environment Configuration
# Copy to .env and fill in actual values.

# Application
ZEMO_APP_NAME=Zemo
ZEMO_APP_VERSION=0.1.0
ZEMO_DEBUG=false
ZEMO_LOG_LEVEL=INFO

# Server (0.0.0.0 binds to all interfaces for localhost + LAN access)
ZEMO_HOST=0.0.0.0
ZEMO_PORT=8000

# Storage
ZEMO_STORAGE_DIR=storage
ZEMO_MAX_UPLOAD_SIZE_MB=50
ZEMO_MAX_RECORD_COUNT=500000

# Security
ZEMO_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080
ZEMO_API_KEY_HEADER=X-API-Key

# AI Provider (Optional — leave blank to disable)
# ZEMO_OPENAI_API_KEY=
# ZEMO_ANTHROPIC_API_KEY=
